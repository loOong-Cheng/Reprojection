// Presentation of robot camera frames in the operator's view (HANDOFF §6).
// Included from M_TeleopPresent (post process, Scene Color Before Bloom) as "/Reprojection/Teleop/Present.ush".
//
// Conventions: UE view space is x right, y up, z forward. Robot frames are pinhole images with horizontal
// FOV 2*atan(TanHalfFov.x), uv (0,0) top-left, v down. RGB = linear scene color, A = view-space depth (cm).
#pragma once

#include "/Reprojection/Teleop/EyeTest.ush"

// Direction of the current pixel in the current eye's view space.
float3 Teleop_PixelViewDir(float2 ViewportUV)
{
	const float2 NDC = float2(ViewportUV.x * 2.0 - 1.0, 1.0 - ViewportUV.y * 2.0);
	// UE projection: clip z = 1 is the near plane, z = 0 the infinite far plane; any z in between is on the ray.
	const float4 V = mul(float4(NDC, 0.5, 1.0), ResolvedView.ClipToView);
	return normalize(V.xyz / V.w);
}

// Pinhole projection of a camera-space direction to uv.
float2 Teleop_ProjectDir(float3 Dir, float2 TanHalfFov)
{
	const float InvZ = 1.0 / max(Dir.z, 1e-4);
	return float2(0.5 + 0.5 * Dir.x * InvZ / TanHalfFov.x,
	              0.5 - 0.5 * Dir.y * InvZ / TanHalfFov.y);
}

// 1 inside the frame, fading to 0 over Feather (uv units) at the border, 0 outside or behind.
float Teleop_FrameWeight(float2 UV, float3 Dir, float Feather)
{
	if (Dir.z <= 1e-4)
	{
		return 0.0;
	}
	const float2 Edge = saturate(min(UV, 1.0 - UV) / max(Feather, 1e-4));
	return Edge.x * Edge.y;
}

// Each eye samples its own robot camera: left eye -> left frame, right eye -> right frame.
float4 Teleop_SampleEyeFrame(Texture2D LeftTex, SamplerState LeftSampler, Texture2D RightTex, SamplerState RightSampler, float2 UV)
{
	if (Teleop_EyeIndex() < 0.5)
	{
		return Texture2DSampleLevel(LeftTex, LeftSampler, UV, 0);
	}
	return Texture2DSampleLevel(RightTex, RightSampler, UV, 0);
}

// M0 naive head-locked: the newest frame is shown as if the robot camera were the current eye (no compensation).
float3 Teleop_PresentM0(float2 ViewportUV, Texture2D LeftTex, SamplerState LeftSampler, Texture2D RightTex, SamplerState RightSampler,
	float2 TanHalfFov, float Feather)
{
	const float3 Dir = Teleop_PixelViewDir(ViewportUV);
	const float2 UV = Teleop_ProjectDir(Dir, TanHalfFov);
	const float W = Teleop_FrameWeight(UV, Dir, Feather);
	if (W <= 0.0)
	{
		return 0.0;
	}
	return Teleop_SampleEyeFrame(LeftTex, LeftSampler, RightTex, RightSampler, saturate(UV)).rgb * W;
}
