# Normalize line endings for anything Git detects as text.
* text=auto

# --- Source / config (text) ------------------------------------
*.cpp       text diff=cpp
*.c         text diff=cpp
*.h         text diff=cpp
*.hpp       text diff=cpp
*.inl       text diff=cpp
*.cs        text diff=csharp
*.usf       text
*.ush       text
*.ini       text
*.uproject  text
*.uplugin   text
*.json      text
*.md        text
*.py        text
*.bat       text eol=crlf
*.sh        text eol=lf

# --- Unreal assets (Git LFS) -----------------------------------
*.uasset    filter=lfs diff=lfs merge=lfs -text
*.umap      filter=lfs diff=lfs merge=lfs -text
*.ubulk     filter=lfs diff=lfs merge=lfs -text
*.uexp      filter=lfs diff=lfs merge=lfs -text

